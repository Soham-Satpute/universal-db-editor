# Server port
PORT=3001

# AES-256 encryption key for saved connection credentials (Day 2)
ENCRYPTION_KEY=replace_with_a_32_byte_random_string

# Groq API key for the Query Playground AI assistant (autocomplete / explain / fix).
# Get one at https://console.groq.com/keys — the assistant is disabled without it.
GROQ_API_KEY=
# Optional: override the default model (llama-3.3-70b-versatile)
GROQ_MODEL=
